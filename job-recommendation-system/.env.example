# Reference only: Flask/Waitress do not auto-load this file.
# Export values in your shell or a deployment secret manager. Never commit .env.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5000
# Leave SECRET_KEY unset locally to generate a private instance key.
# Production requires a random secret of at least 32 characters.
SECRET_KEY=
DATABASE_URL=sqlite:///job_recommendation.db
# JOBMATCH_INSTANCE=/absolute/private/path
PORT=5000
AUTO_UPGRADE_SCHEMA=true
SESSION_IDLE_MINUTES=60
REMEMBER_DAYS=30

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
ENABLE_ADZUNA=true
ENABLE_USAJOBS=false
REAL_JOB_CACHE_TTL_MINUTES=30
EXTERNAL_JOB_STALE_DAYS=14
EXTERNAL_JOB_MAX_AGE_DAYS=60
PROVIDER_REQUESTS_PER_HOUR=60
MAX_RANKING_JOBS=2000

# Development: file writes private instance/mail/*.eml. Never publicly serve it.
# Production: smtp or disabled. Encrypted SMTP is required.
MAIL_BACKEND=file
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=true
LOG_LEVEL=INFO

# Default hybrid works without any transformer or trained artifact.
# Options: weighted (original baseline), hybrid, ltr (experimental).
ML_STRATEGY=hybrid
EMBEDDINGS_ENABLED=false
# Prepare an operator-owned local model once; requests never download it.
EMBEDDING_MODEL_PATH=
# Exact upstream commit used by scripts/prepare_embeddings.py.
EMBEDDING_MODEL_REVISION=unprepared
# Explicit teaching/demo opt-in only; requires ML_STRATEGY=ltr.
ALLOW_SYNTHETIC_RANKER=false
# Optional operator-created, active experiment slug; empty disables experiments.
ML_EXPERIMENT=
